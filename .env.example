# Local development only. Copy to .env (gitignored). Do not use on staging or production.
# Remote stacks use STACK_NAME=a2i-staging or a2i-prod (see deployment-oracle-cloud.md).
# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Actionable AI"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025
MAILCATCHER_HOST=http://localhost:1080

# Postgres. The Compose image is pgvector/pgvector:pg18.
# Embedding size is fixed in backend/app/core/embeddings.py (gemini-embedding-2, 1536).
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5433/app
# pytest uses `{database}_test` on the same server (app → app_test) unless set.
# TEST_DATABASE_URL must end in `_test` (pytest refuses the live app database):
# TEST_DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5433/app_test

# Redis. Compose maps host 6380 to the container. Inside Compose the backend uses redis://redis:6379/0.
REDIS_URL=redis://localhost:6380/0

# Knowledge ingestion. Compose mounts a named volume at /data/knowledge.
# Leave the key empty locally; an upload then finishes as failed instead of calling Gemini.
# Embeddings stay gemini-embedding-2 at 1536, fixed in backend/app/core/embeddings.py.
GEMINI_API_KEY=
# Chat model for the later orchestrator. Ingestion does not call it.
CHAT_MODEL=gemini-3.5-flash-lite
